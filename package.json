{
  "name": "bitnet-wasm-solid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "BitNet b1.58 running locally in the browser via WebAssembly SIMD, with a Solid 2.0 UI",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "build:wasm": "bash scripts/build-wasm.sh",
    "typecheck": "tsc -b --noEmit",
    "check:headers": "node scripts/check-headers.mjs"
  },
  "dependencies": {
    "@solidjs/web": "2.0.0-rc.20",
    "solid-js": "2.0.0-rc.20"
  },
  "devDependencies": {
    "@solidjs/vite-plugin": "^3.0.0-next.55",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vite": "^8.3.5"
  }
}
